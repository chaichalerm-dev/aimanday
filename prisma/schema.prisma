generator client {
  provider      = "prisma-client-js"
  // native = local dev (Windows/Mac); rhel-openssl-* = Vercel serverless runtime
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  estimations Estimation[]
}

model Estimation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  audioName   String
  transcript  String
  sow         Json
  mandayMin   Int
  mandayMax   Int
  modules     Json
  assumptions Json
  createdAt   DateTime @default(now())
  // Optional — pre-auth records have no owner; new records always set this
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id])

  // Index the sort field so the history list query stays fast as data grows
  @@index([createdAt])
  @@index([userId])
}
