generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Estimation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  audioName   String
  transcript  String
  sow         Json
  mandayMin   Int
  mandayMax   Int
  modules     Json
  assumptions Json
  createdAt   DateTime @default(now())
}
