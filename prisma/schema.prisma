generator client {
  provider      = "prisma-client-js"
  // native = local dev (Windows/Mac); rhel-openssl-* = Vercel serverless runtime
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Estimation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  audioName   String
  transcript  String
  sow         Json
  mandayMin   Int
  mandayMax   Int
  modules     Json
  assumptions Json
  createdAt   DateTime @default(now())

  // Index the sort field so the history list query stays fast as data grows
  @@index([createdAt])
}
